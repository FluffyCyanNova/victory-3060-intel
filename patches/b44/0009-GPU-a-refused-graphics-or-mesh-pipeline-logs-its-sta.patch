From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: VIctory contributor <contributor@users.noreply.invalid>
Date: Tue, 24 Nov 2026 23:15:59 -0500
Subject: [PATCH 09/43] GPU: a refused graphics or mesh pipeline logs its state

The translated shaders alone make the windshield wiper's mesh pipeline
(`victory translate` with VICTORY_PAIRS); the run refuses it with
E_INVALIDARG, so what differs is the state.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
(cherry picked from commit 5c659bdcc05b6b43a091d5c69edd76201647b98a)
---
 crates/victory-gpu/src/pipeline/host.rs | 6 ++++--
 1 file changed, 4 insertions(+), 2 deletions(-)

diff --git a/crates/victory-gpu/src/pipeline/host.rs b/crates/victory-gpu/src/pipeline/host.rs
index 0e33780e7..3e5be8203 100644
--- a/crates/victory-gpu/src/pipeline/host.rs
+++ b/crates/victory-gpu/src/pipeline/host.rs
@@ -590,7 +590,9 @@ impl HostPipeline {
             let pso = match mesh_pipeline(&host.device, &root, code(0), code(1), g, depth_bounds, &name) {
                 Ok(pso) => pso,
                 Err(e) => {
-                    tracing::warn!(error = %e, ?shaders, "host mesh pipeline refused");
+                    // The state too: the shaders alone make a pipeline
+                    // with another state (`victory translate` pairs).
+                    tracing::warn!(error = %e, ?shaders, state = %state, "host mesh pipeline refused");
                     host.log_messages();
                     return None;
                 }
@@ -696,7 +698,7 @@ impl HostPipeline {
         let pso = match made {
             Ok(pso) => pso,
             Err(e) => {
-                tracing::warn!(error = %e, ?shaders, "host pipeline refused");
+                tracing::warn!(error = %e, ?shaders, state = %state, "host pipeline refused");
                 host.log_messages();
                 return None;
             }
