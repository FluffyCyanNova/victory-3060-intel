From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: VIctory contributor <contributor@users.noreply.invalid>
Date: Tue, 24 Nov 2026 17:13:46 -0700
Subject: [PATCH 11/43] GPU: the rectangle fallback's f16 rounds to even and
 keeps NaN

The CPU fallback's f32-to-f16 added 0x1000 unconditionally, so an exact
tie went up (`1 + 2^-11` became 0x3c01, round-to-nearest-even keeps
0x3c00; `2048 + 1` became 0x6801, even keeps 0x6800), and any NaN
became infinity. The conversion now decides by the dropped bits like
the subnormal path (round up only past the halfway point, or on it when
the kept mantissa is odd), carries a mantissa overflow into the
exponent, and keeps a NaN: quiet, sign kept, payload where it fits.

A regression covers the two ties, the NaN, the sign, and the two ways a
finite value still reaches 0x7c00.

AI use: written with Codex and Claude Code (GPT-5.2 Codex); reviewed and
posted with my approval. No game files were used.

(cherry picked from commit 2a55fbf85c0a8de0736ce7545c14e83ff7931a5e)
(cherry picked from commit cbb5be6f449d9e2d9f031322c6dcfbdfb145c99a)
---
 crates/victory-gpu/src/primitive.rs | 40 ++++++++++++++++++++++++++---
 1 file changed, 36 insertions(+), 4 deletions(-)

diff --git a/crates/victory-gpu/src/primitive.rs b/crates/victory-gpu/src/primitive.rs
index 3f73ee71e..7907592aa 100644
--- a/crates/victory-gpu/src/primitive.rs
+++ b/crates/victory-gpu/src/primitive.rs
@@ -127,6 +127,11 @@ fn half_to_f32(h: u16) -> f32 {
 fn f32_to_half(v: f32) -> u16 {
     let bits = v.to_bits();
     let sign = ((bits >> 16) & 0x8000) as u16;
+    let abs = bits & 0x7fff_ffff;
+    // A NaN stays one, quiet, with its payload kept where it fits.
+    if abs > 0x7f80_0000 {
+        return sign | 0x7e00 | ((abs >> 13) as u16 & 0x3ff);
+    }
     let exp = ((bits >> 23) & 0xff) as i32 - 127 + 15;
     let man = bits & 0x7f_ffff;
     if exp >= 31 {
@@ -147,10 +152,21 @@ fn f32_to_half(v: f32) -> u16 {
         let m = q + u32::from(r > halfway || (r == halfway && (q & 1) != 0));
         return sign | m as u16;
     }
-    // Rounded to nearest: a carry out of the mantissa is added into the
-    // exponent (`2 - 2^-12` is 2.0); at most it reaches infinity, 0x7c00.
-    let half = (exp as u32) << 10;
-    sign | (half + ((man + 0x1000) >> 13)) as u16
+    // Round to nearest even: the 13 dropped bits decide. A carry out of
+    // the mantissa raises the exponent (`2 - 2^-12` is 2.0); at most it
+    // reaches infinity, 0x7c00.
+    let q = man >> 13;
+    let r = man & 0x1fff;
+    let mut m = q + u32::from(r > 0x1000 || (r == 0x1000 && (q & 1) != 0));
+    let mut exp = exp;
+    if m >> 10 != 0 {
+        m &= 0x3ff;
+        exp += 1;
+    }
+    if exp >= 31 {
+        return sign | 0x7c00;
+    }
+    sign | ((exp as u32) << 10) as u16 | m as u16
 }
 
 #[cfg(test)]
@@ -234,4 +250,20 @@ mod tests {
         assert_eq!(f32_to_half(1.5), 0x3e00);
         assert_eq!(half_to_f32(0x0001), 2f32.powi(-24));
     }
+
+    /// Normal values round to even like the subnormal path: `1 + 2^-11`
+    /// is halfway between `0x3c00` and `0x3c01`, and the even mantissa
+    /// stays. A NaN stays one, quiet (it used to become infinity).
+    #[test]
+    fn f16_halves_round_to_even_and_nan_stays_nan() {
+        assert_eq!(f32_to_half(1.0 + 2f32.powi(-11)), 0x3c00);
+        assert_eq!(f32_to_half(1.0 + 3.0 * 2f32.powi(-11)), 0x3c02);
+        assert_eq!(f32_to_half(2048.0 + 1.0), 0x6800, "a tie above 2048");
+        let nan = f32::from_bits(0x7f80_0000 | 0x200 << 13);
+        assert_eq!(f32_to_half(nan) & 0x7e00, 0x7e00);
+        let negative = f32::from_bits(0xffc0_0000);
+        assert_eq!(f32_to_half(negative) >> 15, 1, "sign kept");
+        assert_eq!(f32_to_half(f32::INFINITY), 0x7c00);
+        assert_eq!(f32_to_half(65520.0), 0x7c00, "finite, but past the largest half");
+    }
 }
