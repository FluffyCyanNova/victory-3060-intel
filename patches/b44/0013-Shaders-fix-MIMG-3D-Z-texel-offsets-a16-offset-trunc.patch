+/// MIMG sampled instruction encoding (`r128 = 0`, `nsa = 0`).
+#[allow(clippy::too_many_arguments)]
+const fn mimg_sample(
+    op: u8,
+    dim: u8,
+    dmask: u8,
+    a16: bool,
+    vdata: u8,
+    vaddr: u8,
+    srsrc: u8,
+    ssamp: u8,
+) -> [u32; 2] {
+    [
+        0x3C << 26
+            | (op as u32 & 0x7F) << 18
+            | (dmask as u32 & 0xF) << 8
+            | (dim as u32 & 7) << 3
+            | (op as u32 >> 7 & 1),
+        (a16 as u32) << 30
+            | ((ssamp as u32 >> 2) & 0x1F) << 21
+            | ((srsrc as u32 >> 2) & 0x1F) << 16
+            | (vdata as u32) << 8
+            | vaddr as u32,
+    ]
+}
