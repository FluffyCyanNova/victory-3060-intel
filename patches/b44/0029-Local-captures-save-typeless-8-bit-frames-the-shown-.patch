From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: VIctory contributor <contributor@users.noreply.invalid>
Date: Wed, 25 Nov 2026 08:10:02 +0800
Subject: [PATCH 29/43] Local: captures save typeless 8-bit frames (the shown
 G-buffer snapshot is f27)

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 crates/victory-gpu/src/capture.rs | 5 +++--
 1 file changed, 3 insertions(+), 2 deletions(-)

diff --git a/crates/victory-gpu/src/capture.rs b/crates/victory-gpu/src/capture.rs
index 19947f3c1..c72b6fa5c 100644
--- a/crates/victory-gpu/src/capture.rs
+++ b/crates/victory-gpu/src/capture.rs
@@ -308,8 +308,9 @@ pub(crate) fn save_read_back(
 ) {
     let f = footprint.Footprint;
     let bgra = match f.Format {
-        DXGI_FORMAT_R8G8B8A8_UNORM | DXGI_FORMAT_R8G8B8A8_UNORM_SRGB => false,
-        DXGI_FORMAT_B8G8R8A8_UNORM | DXGI_FORMAT_B8G8R8A8_UNORM_SRGB => true,
+        // Typeless too: the shown G-buffer snapshot (VICTORY_SHOW_TARGET=world) is f27.
+        DXGI_FORMAT_R8G8B8A8_TYPELESS | DXGI_FORMAT_R8G8B8A8_UNORM | DXGI_FORMAT_R8G8B8A8_UNORM_SRGB => false,
+        DXGI_FORMAT_B8G8R8A8_TYPELESS | DXGI_FORMAT_B8G8R8A8_UNORM | DXGI_FORMAT_B8G8R8A8_UNORM_SRGB => true,
         other => {
             tracing::warn!(format = other.0, "frame not saved: not 8-bit color");
             return;
