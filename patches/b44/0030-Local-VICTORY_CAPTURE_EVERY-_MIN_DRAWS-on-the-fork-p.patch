+/// Draws the last presented frame ran on the host.
+static FRAME_DRAWS: std::sync::atomic::AtomicU64 = std::sync::atomic::AtomicU64::new(0);
+
+/// Local (2026-11-25, ported from our line, cfc1f3b9): `VICTORY_CAPTURE_EVERY=<n>`
+/// saves every `n`th frame that ran at least `VICTORY_CAPTURE_MIN_DRAWS`
+/// draws (default 500: world frames, not loading screens), without tracing.
+fn every(n: u64) -> bool {
+    static SETTING: std::sync::OnceLock<Option<(u64, u64)>> = std::sync::OnceLock::new();
+    let setting = *SETTING.get_or_init(|| {
+        let every = std::env::var("VICTORY_CAPTURE_EVERY").ok()?.trim().parse::<u64>().ok()?;
+        let min = std::env::var("VICTORY_CAPTURE_MIN_DRAWS")
+            .ok()
+            .and_then(|v| v.trim().parse().ok())
+            .unwrap_or(500);
+        (every > 0).then_some((every, min))
+    });
+    setting.is_some_and(|(every, min)| {
+        n % every == 0 && FRAME_DRAWS.load(std::sync::atomic::Ordering::Relaxed) >= min
+    })
+}
+
 /// Whether frame `n` is saved.
 pub(crate) fn wanted(n: u64) -> bool {
     // Before the world, with `VICTORY_CAPTURE_WORLD`: every 16th frame too
@@ -152,7 +174,7 @@ pub(crate) fn wanted(n: u64) -> bool {
     // run, so single frames cannot be compared between runs).
     let first = WORLD.load(std::sync::atomic::Ordering::Relaxed);
     let in_world = world_on() && first != u64::MAX && n > first && (n - first).is_multiple_of(8);
-    folder().is_some() && (n.is_power_of_two() || listed(n) || before_world || in_world)
+    folder().is_some() && (n.is_power_of_two() || listed(n) || before_world || in_world || every(n))
 }
 
