+/// (port of fork #1188's part of `wrote_own`) We wrote the 64 KiB page
+/// numbered `page` of title memory ourselves and reset the kernel's
+/// write-watch bits behind the write (`Shadow::put_back_quiet`), so the
+/// journal is told here: the page counts as written at a new asking, which
+/// every host copy that holds it takes at its next refresh. Returns the
+/// asking that had last found `page` written (0: never) and the new one,
+/// for the copy that wrote to note itself current.
+pub(crate) fn wrote_own(page: usize) -> (u64, u64) {
+    let mut j = JOURNAL.lock().unwrap_or_else(|e| e.into_inner());
+    let j = &mut *j;
+    j.asked += 1;
+    let now = j.asked;
+    // As in [`wrote`]: an asking that stands for a submission, or for a
+    // flush, moves with it, or a copy taking the page at the standing
+    // asking would find it written "later" at every refresh.
+    if j.kept || !j.ahead.is_empty() {
+        j.ahead_asked = now;
+    }
+    let before = j.written.insert(page, now).unwrap_or(0);
+    (before, now)
+}
+
 /// One kernel asking for `pieces` (page ranges in order); by halves if it
 /// fails, as a run across two reservations or into memory that is not
 /// write-watched does. A piece alone is left to [`writes`].
