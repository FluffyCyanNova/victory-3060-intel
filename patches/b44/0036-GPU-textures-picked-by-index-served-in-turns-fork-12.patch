+/// (local: OFF unless `VICTORY_FAIR_DUE=1`; the fork has it on unless `=0`.
+/// On in unit tests, which check the turns.)
+fn fair_due() -> bool {
+    static ON: std::sync::OnceLock<bool> = std::sync::OnceLock::new();
+    cfg!(test) || *ON.get_or_init(|| std::env::var_os("VICTORY_FAIR_DUE").is_some_and(|v| v == "1"))
