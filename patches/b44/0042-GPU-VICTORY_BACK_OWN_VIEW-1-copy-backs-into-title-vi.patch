@@ -3313,6 +3319,58 @@ fn quiet_back() -> bool {
 static QUIET: [AtomicU64; 3] = [const { AtomicU64::new(0) }; 3];
 
 impl Shadow {
+    /// (hand port of the fork's `put_back_own`, a2537066 / 39731795,
+    /// `VICTORY_BACK_OWN_VIEW=1`, off by default; without its
+    /// `VICTORY_BACK_OWN_CHECK` part) What a merge made of title view
+    /// memory `[at, at + bytes.len())` (inside one 64 KiB page) is stored
+    /// through a view of our own on the same section
+    /// (`crate::inplace::write_own`): no guard is opened, so the write does
+    /// not read as the title's. The journal is told the page changed, at
+    /// every address that shows it, so every other copy takes it again, and
+    /// this copy notes itself current. False with nothing written if the
+    /// switch is off or the memory is not such a view: the caller writes as
+    /// before.
+    fn put_back_own(&self, at: usize, bytes: &[u8]) -> bool {
+        /// Since the start: stretches and bytes stored this way, pages
+        /// noted current for their copy, stretches written the old way.
+        static OWN_WRITES: [AtomicU64; 4] = [const { AtomicU64::new(0) }; 4];
+        if !crate::inplace::back_own() {
+            return false;
+        }
+        let Some(shown) = crate::inplace::write_own(at, bytes) else {
+            OWN_WRITES[3].fetch_add(1, Ordering::Relaxed);
+            return false;
+        };
+        let page = at / PAGE;
+        let others: Vec<usize> = shown.iter().map(|&a| a / PAGE).filter(|&p| p != page).collect();
+        let (before, now) = crate::watch::wrote_own(page, &others);
+        // A placed texture there changed with no descriptor written (what
+        // `crate::watch::writing` tells the texture table on the old way).
+        crate::descriptor::host::remapped(at, bytes.len());
+        let base = self.start as usize / PAGE;
+        {
+            let mut copied = self.copied.lock().unwrap_or_else(|e| e.into_inner());
+            if let Some(taken) = page.checked_sub(base).and_then(|i| copied.get_mut(i))
+                && *taken != 0
+                && *taken >= before
+            {
+                *taken = (*taken).max(now);
+                OWN_WRITES[2].fetch_add(1, Ordering::Relaxed);
+            }
+        }
+        OWN_WRITES[1].fetch_add(bytes.len() as u64, Ordering::Relaxed);
+        let n = OWN_WRITES[0].fetch_add(1, Ordering::Relaxed) + 1;
+        if n.is_multiple_of(16384) {
+            tracing::info!(
+                "what shaders wrote, stored through views of our own (VICTORY_BACK_OWN_VIEW=1), since the start: {n} stretches {} MB, {} pages noted current for the copy that wrote them; written the old way (not such a view): {}",
+                OWN_WRITES[1].load(Ordering::Relaxed) >> 20,
+                OWN_WRITES[2].load(Ordering::Relaxed),
+                OWN_WRITES[3].load(Ordering::Relaxed)
+            );
+        }
+        true
+    }
+
     /// (hand port of fork #1188, `VICTORY_BACK_QUIET=1`, off by default)
     /// What a merge made of private, write-watched title memory
     /// `[at, at + bytes.len())` is written as before, then the kernel's
@@ -3350,7 +3408,7 @@ impl Shadow {
         crate::descriptor::host::remapped(at, bytes.len());
         let base = self.start as usize / PAGE;
         for page in at / PAGE..(at + bytes.len()).div_ceil(PAGE) {
-            let (before, now) = crate::watch::wrote_own(page);
+            let (before, now) = crate::watch::wrote_own(page, &[]);
             let mut copied = self.copied.lock().unwrap_or_else(|e| e.into_inner());
             if let Some(taken) = page.checked_sub(base).and_then(|i| copied.get_mut(i))
                 && *taken != 0
diff --git a/crates/victory-gpu/src/watch.rs b/crates/victory-gpu/src/watch.rs
index e323e5202..176379549 100644
--- a/crates/victory-gpu/src/watch.rs
+++ b/crates/victory-gpu/src/watch.rs
@@ -260,7 +260,7 @@ pub(crate) fn wrote(at: usize, len: usize) {
 /// every host copy that holds it takes at its next refresh. Returns the
 /// asking that had last found `page` written (0: never) and the new one,
 /// for the copy that wrote to note itself current.
-pub(crate) fn wrote_own(page: usize) -> (u64, u64) {
+pub(crate) fn wrote_own(page: usize, others: &[usize]) -> (u64, u64) {
     let mut j = JOURNAL.lock().unwrap_or_else(|e| e.into_inner());
     let j = &mut *j;
     j.asked += 1;
@@ -272,6 +272,12 @@ pub(crate) fn wrote_own(page: usize) -> (u64, u64) {
         j.ahead_asked = now;
     }
     let before = j.written.insert(page, now).unwrap_or(0);
+    // The same physical page at its other title addresses (page numbers).
+    for &other in others {
+        if other != page {
+            j.written.insert(other, now);
+        }
+    }
     (before, now)
 }
 
