+/// (local) `VICTORY_KEEP_GONE`: a texture picked by index whose memory the
+/// title has unmapped ("streamed out") keeps its host view, so the slot
+/// goes on showing its last texture while the memory is away, instead of
+/// a null view (black) until it is back and uploaded again. Off by default.
+/// - `1`: kept for as long as the memory is away;
+/// - a larger number: kept for that many frames from the pass that first
+///   found it away, then made null as before.
+/// Either way the view is made null at once while the card is over its
+/// video-memory budget (a kept view keeps its host copy from being let
+/// go). True if slot `index` is to be kept in frame `frame`.
+fn keep_gone(index: u32, frame: u64) -> bool {
+    use std::sync::{Mutex, OnceLock};
+    static FRAMES: OnceLock<u64> = OnceLock::new();
+    let frames = *FRAMES.get_or_init(|| std::env::var("VICTORY_KEEP_GONE").ok().and_then(|v| v.trim().parse().ok()).unwrap_or(0));
+    if frames == 0 {
+        return false;
+    }
+    /// The frame the budget was last asked in, and whether the card was over it.
+    static OVER: Mutex<(u64, bool)> = Mutex::new((u64::MAX, false));
+    let over = {
+        let mut o = OVER.lock().unwrap_or_else(|e| e.into_inner());
+        if o.0 != frame {
+            let over = crate::host::host().and_then(|h| h.video_memory_groups()).is_some_and(|[own, _]| own[0] != 0 && own[1] > own[0]);
+            *o = (frame, over);
+        }
+        o.1
+    };
+    let mut since = KEEP_GONE_SINCE.lock().unwrap_or_else(|e| e.into_inner());
+    let first = *since.entry(index).or_insert(frame);
+    let keep = !over && (frames == 1 || frame.saturating_sub(first) < frames);
+    if !keep {
+        since.remove(&index);
+    }
+    let n = KEEP_GONE[usize::from(!keep)].fetch_add(1, Ordering::Relaxed) + 1;
+    if n.is_multiple_of(4096) {
+        tracing::info!(
+            "textures picked by index whose memory is away (VICTORY_KEEP_GONE={frames}) since the start: {} looks kept the last view, {} made null (kept long enough, or the card over its budget); {} slots away now",
+            KEEP_GONE[0].load(Ordering::Relaxed),
+            KEEP_GONE[1].load(Ordering::Relaxed),
+            since.len()
+        );
+    }
+    keep
+}
+
+/// [`keep_gone`]: looks that kept the view, looks that made it null.
+static KEEP_GONE: [AtomicU64; 2] = [const { AtomicU64::new(0) }; 2];
+
+/// [`keep_gone`]: the frame each slot was first found away in.
+static KEEP_GONE_SINCE: std::sync::Mutex<std::collections::BTreeMap<u32, u64>> = std::sync::Mutex::new(std::collections::BTreeMap::new());
+
