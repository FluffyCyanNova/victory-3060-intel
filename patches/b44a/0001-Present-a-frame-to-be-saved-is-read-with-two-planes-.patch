From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: VIctory contributor <contributor@users.noreply.invalid>
Date: Thu, 26 Nov 2026 18:15:18 +0800
Subject: [PATCH] Present: a frame to be saved is read with two planes too (the
 blended frame)

With two present planes (the Series S interface, fork #1081) the present
blends them into the back buffer and returns before the copy where a
frame to be saved is read back, so no frame was saved in b44run1
(VICTORY_CAPTURE set as in the runs before; 0 "frame saved" lines).

In that path the frame is now read from the back buffer after the blend
(to the copy-source state and back around the read) and saved after the
list has run, as on the one-plane path: the saved picture is the blended
frame, as shown. The black-frame probe is still made on the one-plane
path only. Diagnostics builds only, as before.

Co-Authored-By: Claude Fable 5.2 <noreply@anthropic.com>
---
 crates/victory-gpu/src/host.rs | 25 +++++++++++++++++++++++++
 1 file changed, 25 insertions(+)

diff --git a/crates/victory-gpu/src/host.rs b/crates/victory-gpu/src/host.rs
index e4f3a21a1..afd625b72 100644
--- a/crates/victory-gpu/src/host.rs
+++ b/crates/victory-gpu/src/host.rs
@@ -6748,6 +6748,27 @@ impl Host {
                         overlay,
                         overlay_state,
                     );
+                    // (local) A frame to be saved is read from the back buffer
+                    // here: the two planes as blended, which is what is shown.
+                    // (The copy below, where frames are read otherwise, is not
+                    // reached with two planes: b44 saved none.)
+                    #[cfg(feature = "diagnostics")]
+                    let capture = crate::capture::wanted(frame)
+                        .then(|| {
+                            list.ResourceBarrier(&[transition(
+                                &back,
+                                D3D12_RESOURCE_STATE_PRESENT,
+                                D3D12_RESOURCE_STATE_COPY_SOURCE,
+                            )]);
+                            let read = crate::capture::read_back(&self.device, list, &back);
+                            list.ResourceBarrier(&[transition(
+                                &back,
+                                D3D12_RESOURCE_STATE_COPY_SOURCE,
+                                D3D12_RESOURCE_STATE_PRESENT,
+                            )]);
+                            read
+                        })
+                        .flatten();
                     copy.close();
                     match slot {
                         Some(i) => {
@@ -6756,6 +6777,10 @@ impl Host {
                         }
                         None => self.execute(&[copy]),
                     }
+                    #[cfg(feature = "diagnostics")]
+                    if let Some((buffer, footprint)) = capture {
+                        crate::capture::save_read_back(frame, &buffer, &footprint);
+                    }
                     let _ = p.swap_chain.Present(0, DXGI_PRESENT(0));
                     p.meter.frame(p.hwnd);
                     return Some(false);
