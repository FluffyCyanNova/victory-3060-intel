diff --git a/crates/victory-gpu/src/resource.rs b/crates/victory-gpu/src/resource.rs
index db527b5bf..627d12bd9 100644
--- a/crates/victory-gpu/src/resource.rs
+++ b/crates/victory-gpu/src/resource.rs
@@ -2569,6 +2569,22 @@ pub(crate) fn placed_bytes(desc: &[u32; 14]) -> Option<u64> {
     footprint(&d).map(|f| f.size)
 }
 
+/// For a log line: a placed texture's dimension, format, width, height,
+/// depth or layers, and levels, from its description as words.
+#[cfg(feature = "diagnostics")]
+pub(crate) fn placed_shape(desc: &[u32; 14]) -> [u64; 6] {
+    // SAFETY: 56 bytes in the description's layout.
+    let d = unsafe { desc.as_ptr().cast::<ResourceDesc>().read_unaligned() };
+    [
+        u64::from(d.dimension),
+        u64::from(d.format),
+        d.width,
+        u64::from(d.height),
+        u64::from(d.depth_or_array_size),
+        u64::from(d.mip_levels),
+    ]
+}
