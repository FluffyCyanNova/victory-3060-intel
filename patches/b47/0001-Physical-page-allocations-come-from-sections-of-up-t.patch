+    #[test]
+    fn physical_page_numbers_and_writes_continue_across_sections() {
+        let per = section_pages();
+        // One page more than two sections hold (33 pages if there is no
+        // limit: one run).
+        let n = if per == usize::MAX { 33 } else { 2 * per + 1 };
+        let pages = allocate(n);
+        assert!(pages.windows(2).all(|pair| pair[1] == pair[0] + FRAMES));
+        let groups = runs(&pages, 0, n * PAGE).unwrap();
+        let counts: Vec<usize> = groups.iter().map(|(_, count)| *count).collect();
