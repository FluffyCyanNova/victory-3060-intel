+/// The most pages one section backs: `VICTORY_SECTION_MB` MiB, 2 unless
+/// said (local default; the fork has it off unless said); 0: no limit, one
+/// section per allocation, as before. While the title maps and unmaps
+/// views of a section, Windows holds that section's lock, and so does its
+/// worker that rebuilds large pages: with one section of 6.1 GiB every
+/// remap waits behind it (run b44run1: a median 17.5 ms a frame, at most
+/// 1.3 s). (RyanCase94, fork #1089; KainanP, upstream #3177; CuteBooty,
+/// fork #1274.)
+fn section_pages() -> usize {
+    static PAGES: LazyLock<usize> = LazyLock::new(|| pages_per_section(std::env::var("VICTORY_SECTION_MB").ok().as_deref()));
+    *PAGES
+}
+
+/// [`section_pages`] for what `VICTORY_SECTION_MB` holds.
+fn pages_per_section(said: Option<&str>) -> usize {
+    match said.map(|v| v.trim().parse::<usize>()) {
+        Some(Ok(0)) => usize::MAX,
+        Some(Ok(mb)) => mb.saturating_mul(MIB / PAGE),
+        // Unset, or not a number.
+        _ => 2 * (MIB / PAGE),
+    }
+}
