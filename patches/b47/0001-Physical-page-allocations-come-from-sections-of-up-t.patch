+/// The runtime closes `section`: its last page and the title's last view
+/// of it are gone. A view of our own on it ([`write_own`]) is unmapped
+/// before Windows can give the handle's number to another section (an
+/// allocation is many small sections now, so numbers come round).
+pub fn title_memory_section_closed(section: usize) {
+    views().sections.remove(&section);
+    let mut own = OWN.lock().unwrap_or_else(|e| e.into_inner());
+    if let Some(Some(view)) = own.as_mut().and_then(|views| views.remove(&section)) {
