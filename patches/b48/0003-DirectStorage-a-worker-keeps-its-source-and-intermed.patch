+    /// A worker keeps its buffers between requests, but not a very large one.
+    #[test]
+    fn a_worker_keeps_its_buffers_but_not_a_huge_one() {
+        let mut scratch = WorkerScratch::default();
+        scratch.source.resize(64 << 10, 0);
+        scratch.intermediate.resize(128 << 10, 0);
+        let (source, intermediate) = (scratch.source.as_ptr(), scratch.intermediate.as_ptr());
+        scratch.trim();
+        assert_eq!(scratch.source.as_ptr(), source);
+        assert_eq!(scratch.intermediate.as_ptr(), intermediate);
+        scratch.source.resize(SCRATCH_KEPT + 4096, 0);
+        scratch.trim();
+        assert_eq!(scratch.source.capacity(), 0);
+        assert_eq!(scratch.intermediate.as_ptr(), intermediate);
+    }
