+/// The most a worker keeps of each of its buffers between requests: one
+/// large read does not hold its memory for the rest of the run.
+const SCRATCH_KEPT: usize = 8 << 20;
+
+/// A worker's buffers, kept from one request to the next (a worker runs one
+/// request at a time): a compressed request's source, and what zlib leaves
+/// for BCPack. A buffer for each request was allocated and filled with
+/// zeros first, hundreds of times a second.
+#[derive(Default)]
+struct WorkerScratch {
+    source: Vec<u8>,
+    intermediate: Vec<u8>,
+}
+
+impl WorkerScratch {
+    fn trim(&mut self) {
+        for buffer in [&mut self.source, &mut self.intermediate] {
+            if buffer.capacity() > SCRATCH_KEPT {
+                *buffer = Vec::new();
+            }
+        }
+    }
+}
