 /// (title+0x2477578 and title+0x24800d5) as `(this, description, interface
 /// id, out)`, asks for `ID3D12PipelineState`, and on success keeps the
@@ -369,6 +448,8 @@ extern "system" fn unknown_pipeline<const SLOT: usize>(
         // SAFETY: the title's out pointer (a local of its own).
         unsafe { *out = std::ptr::null() };
     }
+    #[cfg(windows)]
+    pipeline_x_dump(SLOT, calls, desc);
     if calls <= 4 || calls.is_power_of_two() {
         // Sixteen 64-bit words at `at`, read through the kernel: neither
         // pointer is known to be mapped.
@@ -464,6 +545,47 @@ mod tests {
     use super::*;
     use crate::object::slot;
 
+    /// The first call of method 0x1c8 a run logged: six pieces, each an
+    /// address and a length.
+    #[test]
+    fn the_pieces_of_a_0x1c8_description_are_its_address_and_length_pairs() {
+        let words = [
+            0x1c7dcc6e990, 0x904b186f4, 0x184, 0x904b18878, 0xbc, 0x948a27300, 0x200, 0x904b18934, 0xd0, 0x948a27500, 0x200,
+            0x904b18a04, 0xb0, 0, 0, 0,
+        ];
+        assert_eq!(
+            pipeline_x_pieces(&words),
+            [
+                (1, 0x904b186f4, 0x184),
+                (3, 0x904b18878, 0xbc),
+                (5, 0x948a27300, 0x200),
+                (7, 0x904b18934, 0xd0),
+                (9, 0x948a27500, 0x200),
+                (11, 0x904b18a04, 0xb0)
+            ]
+        );
+    }
+
+    /// The first call of method 0x218: four pieces with lengths, two
+    /// addresses alone (256 bytes each); the hash-like word and zeros are
+    /// no pieces.
+    #[test]
+    fn the_pieces_of_a_0x218_description_include_lone_addresses() {
+        let words =
+            [0x1c7e598a760, 0x904b147c0, 0x1c, 0x904b147dc, 0x14, 0x948a20000, 0x180, 0x904b147f0, 0x118, 0x90729a6e0, 0x907269de0, 0xd7e7b1a22f0c3802, 0];
+        assert_eq!(
+            pipeline_x_pieces(&words),
+            [
+                (1, 0x904b147c0, 0x1c),
+                (3, 0x904b147dc, 0x14),
+                (5, 0x948a20000, 0x180),
+                (7, 0x904b147f0, 0x118),
+                (9, 0x90729a6e0, 256),
+                (10, 0x907269de0, 256)
+            ]
+        );
+    }
+
