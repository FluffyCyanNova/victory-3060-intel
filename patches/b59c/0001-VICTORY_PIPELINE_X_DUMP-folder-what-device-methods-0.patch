index dfbf2b225..d6a4cc0af 100644
--- a/crates/victory-gpu/src/device.rs
+++ b/crates/victory-gpu/src/device.rs
@@ -346,6 +346,85 @@ fn feature_levels(data: *mut c_void) -> HRESULT {
     }
 }
 
+/// The pieces a description of device method 0x1c8 or 0x218 names, from
+/// its 64-bit `words`: `(word, address, bytes)`. A word that is an
+/// address followed by a length of up to 1 MiB is a piece of that length
+/// (the length's word is then skipped); an address alone is looked at for
+/// 256 bytes. Word 0 is the root signature, an object of ours.
+fn pipeline_x_pieces(words: &[u64]) -> Vec<(usize, u64, usize)> {
+    let address = |w: u64| (0x1_0000..1 << 47).contains(&w);
+    let mut pieces = Vec::new();
+    let mut i = 1;
+    while i < words.len() {
+        let w = words[i];
+        match words.get(i + 1) {
+            Some(&len @ 1..=0x10_0000) if address(w) => {
+                pieces.push((i, w, len as usize));
+                i += 2;
+            }
+            _ => {
+                if address(w) {
+                    pieces.push((i, w, 256));
+                }
+                i += 1;
+            }
+        }
+    }
+    pieces
+}
+
+/// `VICTORY_PIPELINE_X_DUMP=<folder>`: the descriptions of the first 8
+/// calls of device methods 0x1c8 and 0x218 each, written there so that the
+/// two methods can be worked out: `x<slot>-<call>.txt` with the
+/// description's first 64 words, and `x<slot>-<call>-w<word>-<bytes>.bin`
+/// for each piece they name ([`pipeline_x_pieces`]), read through the
+/// kernel (none of it is known to be mapped). The files hold the title's
+/// data: they stay on this machine. Off when unset; the call fails as it
+/// did either way.
+#[cfg(windows)]
+fn pipeline_x_dump(slot: usize, call: u32, desc: *const u8) {
+    static DIR: std::sync::OnceLock<Option<std::path::PathBuf>> = std::sync::OnceLock::new();
+    let Some(dir) = DIR.get_or_init(|| {
+        let dir = std::path::PathBuf::from(std::env::var_os("VICTORY_PIPELINE_X_DUMP")?);
+        match std::fs::create_dir_all(&dir) {
+            Ok(()) => {
+                tracing::info!(dir = %dir.display(), "descriptions of device methods 0x1c8 and 0x218 are written out (VICTORY_PIPELINE_X_DUMP)");
+                Some(dir)
+            }
+            Err(e) => {
+                tracing::warn!(error = %e, dir = %dir.display(), "VICTORY_PIPELINE_X_DUMP: no such folder can be made");
+                None
+            }
+        }
+    }) else {
+        return;
+    };
+    if call > 8 || desc.is_null() {
+        return;
+    }
+    let mut bytes = [0u8; 512];
+    if !crate::host::read_into(desc, &mut bytes) {
+        return;
+    }
+    let words: Vec<u64> = bytes.as_chunks::<8>().0.iter().map(|c| u64::from_le_bytes(*c)).collect();
+    let mut text = format!("slot {slot:#x} call {call} description at {:#x}\n", desc as usize);
+    for (i, w) in words.iter().enumerate() {
+        text.push_str(&format!("w{i:02} {w:#018x}\n"));
+    }
+    // Only the description's own words name its pieces: 0x1c8 has 16 of
+    // them at most, 0x218 has 13 and the next description behind them.
+    let own = if slot == 0x218 { 13 } else { 16 };
+    for (i, at, len) in pipeline_x_pieces(&words[..own]) {
+        let mut piece = vec![0u8; len];
+        let read = crate::host::read_into(at as *const u8, &mut piece);
+        text.push_str(&format!("piece w{i:02} at {at:#x}, {len} bytes: {}\n", if read { "written" } else { "not readable" }));
+        if read {
+            let _ = std::fs::write(dir.join(format!("x{slot:x}-{call}-w{i:02}-{len}.bin")), &piece);
+        }
+    }
+    let _ = std::fs::write(dir.join(format!("x{slot:x}-{call}.txt")), text);
+}
+
