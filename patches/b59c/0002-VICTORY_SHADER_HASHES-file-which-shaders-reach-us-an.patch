+    /// A part's data with an `XDAT` index of these blobs behind it.
+    fn xdat_part(blobs: &[(u32, &[u8])]) -> Vec<u8> {
+        let mut part = vec![0u8; 0x18];
+        part.extend_from_slice(b"XDAT");
+        part.extend_from_slice(&(blobs.len() as u32).to_le_bytes());
+        part.extend_from_slice(&0x24u32.to_le_bytes());
+        let mut at = part.len() + 12 * blobs.len();
