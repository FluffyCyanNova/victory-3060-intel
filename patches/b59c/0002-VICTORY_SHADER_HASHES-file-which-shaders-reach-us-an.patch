+/// `VICTORY_SHADER_HASHES=<file>`: `line()` appended to it, a line of its
+/// own (off when unset, and `line` is not called). The file says which
+/// shaders reach us and how: one line for each container the title hands
+/// a pipeline creation ([`container_line`]) and one for each call of
+/// device methods 0x1c8 and 0x218, which hand over code and records
+/// instead (`device::pipeline_x_hashes`). Joined on the code's hash, the
+/// two tell whether the shaders of those two methods come as containers
+/// too, and how many there are.
+pub(crate) fn hash_line(line: impl FnOnce() -> String) {
+    use std::io::Write;
+    static OUT: OnceLock<Option<Mutex<std::fs::File>>> = OnceLock::new();
+    let Some(out) = OUT.get_or_init(|| {
+        let path = std::env::var_os("VICTORY_SHADER_HASHES")?;
+        match std::fs::OpenOptions::new().create(true).append(true).open(&path) {
+            Ok(file) => {
+                tracing::info!(file = %std::path::Path::new(&path).display(), "shader hashes are listed (VICTORY_SHADER_HASHES)");
+                Some(Mutex::new(file))
+            }
+            Err(e) => {
+                tracing::warn!(error = %e, "VICTORY_SHADER_HASHES: the file cannot be opened");
+                None
+            }
+        }
+    }) else {
+        return;
+    };
+    let mut text = line();
+    text.push('\n');
+    let _ = out.lock().unwrap_or_else(|e| e.into_inner()).write_all(text.as_bytes());
+}
+
+/// `bytes` as lowercase hex.
+pub(crate) fn hex(bytes: &[u8]) -> String {
+    bytes.iter().map(|b| format!("{b:02x}")).collect()
+}
+
+/// A program's native code for [`hash_line`]: its length, its first 32
+/// bytes (the prologue the console compiler writes the shader's hash
+/// into) and the first 16 hex digits of the code's BLAKE3 hash.
+pub(crate) fn code_words(code: &[u8]) -> String {
+    format!(
+        "len={} head={} code={}",
+        code.len(),
+        hex(&code[..code.len().min(32)]),
+        &blake3::hash(code).to_hex()[..16]
+    )
+}
+
+/// The first blob of `kind` in the `XDAT` index of a `DXIL` part's data
+/// (`victory_shader::native`: the index sits at +0x18, a count at +0x1c,
+/// then 12 bytes an entry: kind, offset and size, the offset from the
+/// start of the part's data). Kind 0x10 is the shader's 16-byte hash.
+pub(crate) fn xdat_blob(part: &[u8], kind: u32) -> Option<&[u8]> {
+    let word = |at: usize| Some(u32::from_le_bytes(part.get(at..at + 4)?.try_into().ok()?));
+    if part.get(0x18..0x1c)? != b"XDAT" {
+        return None;
+    }
+    let count = word(0x1c)?.min(64) as usize;
+    (0..count).find_map(|i| {
+        let at = 0x24 + 12 * i;
+        if word(at)? != kind {
+            return None;
+        }
+        let (offset, size) = (word(at + 4)? as usize, word(at + 8)? as usize);
+        part.get(offset..offset.checked_add(size)?)
+    })
+}
+
+/// A container's line for [`hash_line`]: the name we give it, its stage,
+/// its shader hash (`xdat10`) and each native program in it
+/// ([`code_words`]).
+fn container_line(stage: &str, name: &str, bytes: &[u8]) -> String {
+    use victory_shader::{Container, FourCC};
+    let mut line = format!("container {name} {stage}");
+    let Ok(container) = Container::parse(bytes) else {
+        return line + " unparsed";
+    };
+    let Some(part) = container.part(FourCC::DXIL) else {
+        return line + " no-dxil-part";
+    };
+    line.push_str(&format!(" xdat10={}", xdat_blob(part.data, 0x10).map_or_else(|| "-".to_owned(), hex)));
+    match victory_shader::native_programs(part.data) {
+        Ok(programs) => {
+            for p in &programs {
+                line.push_str(&format!(" | {:?} {}", p.stage, code_words(&p.code)));
+            }
+        }
+        Err(e) => line.push_str(&format!(" | native programs: {e}")),
+    }
+    line
+}
