+/// The last entry of a stage's record in a description of device method
+/// 0x1c8 or 0x218: its tag and the 16 bytes behind it. The records end
+/// with an entry of 32 bytes tagged 0x43 that holds the shader's hash.
+fn record_tail(record: &[u8]) -> Option<(u32, [u8; 16])> {
+    let at = record.len().checked_sub(32)?;
+    let tag = u32::from_le_bytes(record[at..at + 4].try_into().ok()?);
+    Some((tag, record[at + 4..at + 20].try_into().ok()?))
+}
+
+/// A call of device method 0x1c8 or 0x218 for
+/// `VICTORY_SHADER_HASHES` (`pipeline::hash_line`): the method, the call's
+/// number, what its small pieces are (the state block's and the input
+/// layout's hash for 0x1c8; the two small pieces' and the hash-like word
+/// for 0x218) and, for each stage it names, the code
+/// (`pipeline::code_words`) and its record's last entry ([`record_tail`]).
+/// What cannot be read is said so.
+#[cfg(windows)]
+fn pipeline_x_hashes(slot: usize, call: u32, desc: *const u8) -> String {
+    use crate::pipeline::{code_words, hex};
+    let mut line = format!("x{slot:x} call={call}");
+    let mut bytes = [0u8; 128];
+    if desc.is_null() || !crate::host::read_into(desc, &mut bytes) {
+        return line + " description not readable";
+    }
+    let words: Vec<u64> = bytes.as_chunks::<8>().0.iter().map(|c| u64::from_le_bytes(*c)).collect();
+    // A piece named by words `i` (address) and `i + 1` (length).
+    let piece = |i: usize| -> Option<Vec<u8>> {
+        let (at, len) = (words[i], words[i + 1] as usize);
+        if at == 0 || len == 0 || len > 0x10_0000 {
+            return None;
+        }
+        let mut piece = vec![0u8; len];
+        crate::host::read_into(at as *const u8, &mut piece).then_some(piece)
+    };
+    let sum = |i: usize| piece(i).map_or_else(|| "-".to_owned(), |p| format!("{}:{}", p.len(), &blake3::hash(&p).to_hex()[..16]));
+    let stages: &[(usize, usize)] = if slot == 0x218 {
+        line.push_str(&format!(" state={} small={} word={:016x}", sum(1), sum(3), words[11]));
+        &[(5, 7)]
+    } else {
+        line.push_str(&format!(" state={} layout={}", sum(1), sum(3)));
+        &[(5, 7), (9, 11)]
+    };
+    for &(code, record) in stages {
+        match (piece(code), piece(record)) {
+            (None, None) => line.push_str(" | none"),
+            (code, record) => {
+                line.push_str(" | ");
+                line.push_str(&code.map_or_else(|| "code not readable".to_owned(), |c| code_words(&c)));
+                match record.as_deref().map(|r| (r.len(), record_tail(r))) {
+                    Some((len, Some((tag, hash)))) => line.push_str(&format!(" record={len} tag={tag:#x} hash={}", hex(&hash))),
+                    Some((len, None)) => line.push_str(&format!(" record={len} short")),
+                    None => line.push_str(" record not readable"),
+                }
+            }
+        }
+    }
+    line
+}
