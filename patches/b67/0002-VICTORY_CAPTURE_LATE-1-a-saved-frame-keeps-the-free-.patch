+/// Whether a frame that is saved for its picture only is presented as
+/// every other frame is, its picture read back inside the present's own
+/// flight and written out by a thread of ours once the card has run it
+/// (`VICTORY_CAPTURE_LATE=1`; off by default: a saved frame is presented
+/// the old way, the flights settled at the present and the picture read
+/// back and compressed there, under the submission lock).
+///
+/// Why: with a picture of every frame or every second one, the thread
+/// that submits waited 64 to 83 ms a frame for the submission lock in the
+/// runs looked at, the size of one settle of 120 to 170 ms every second
+/// frame. Listed frames (their operations and targets are written too)
+/// keep the old way.
+pub(crate) fn late() -> bool {
+    static ON: std::sync::OnceLock<bool> = std::sync::OnceLock::new();
+    *ON.get_or_init(|| {
+        let on = std::env::var("VICTORY_CAPTURE_LATE").is_ok_and(|v| v.trim() == "1");
+        if on {
+            tracing::info!("saved frames are read back inside their present's flight and written out behind it (VICTORY_CAPTURE_LATE=1)");
+        }
+        on
+    })
+}
+
+/// A frame's picture in a read-back buffer the card fills in submission
+/// `flown` ([`save_later`]).
+struct Later {
+    frame: u64,
+    buffer: ID3D12Resource,
+    footprint: D3D12_PLACED_SUBRESOURCE_FOOTPRINT,
+    flown: u64,
+}
+
+// SAFETY: host buffers are free-threaded objects; the footprint is plain
+// data. The buffer is touched by one thread at a time: recorded into a
+// list here, then handed to the thread that saves, which alone maps it.
+unsafe impl Send for Later {}
+
+/// Saves frame `frame` from `buffer` ([`read_back`]) once submission
+/// `flown` has finished, on a thread of ours: the mapping, the half-size
+/// picture, its compression and the file are that thread's work. A
+/// submission that has not finished after ten seconds is given up on (the
+/// device is gone, or the run is ending).
+pub(crate) fn save_later(frame: u64, buffer: ID3D12Resource, footprint: D3D12_PLACED_SUBRESOURCE_FOOTPRINT, flown: u64) {
+    static QUEUE: std::sync::OnceLock<Option<std::sync::Mutex<std::sync::mpsc::Sender<Later>>>> = std::sync::OnceLock::new();
+    let queue = QUEUE.get_or_init(|| {
+        let (send, receive) = std::sync::mpsc::channel::<Later>();
+        let made = std::thread::Builder::new().name("victory frame saver".into()).spawn(move || {
+            for later in receive {
+                let began = std::time::Instant::now();
+                while crate::host::finished() < later.flown {
+                    if began.elapsed() > std::time::Duration::from_secs(10) {
+                        break;
+                    }
+                    std::thread::sleep(std::time::Duration::from_millis(2));
+                }
+                if crate::host::finished() >= later.flown {
+                    save_read_back(later.frame, &later.buffer, &later.footprint);
+                } else {
+                    tracing::warn!(frame = later.frame, "frame not saved: the card did not run its present in ten seconds");
+                }
+            }
+        });
+        match made {
+            Ok(_) => Some(std::sync::Mutex::new(send)),
+            Err(e) => {
+                tracing::warn!(error = %e, "no thread to save frames: they are not saved");
+                None
+            }
+        }
+    });
+    if let Some(queue) = queue {
+        let _ = queue.lock().unwrap_or_else(|e| e.into_inner()).send(Later { frame, buffer, footprint, flown });
+    }
+}
