+/// Why the host would refuse a buffer view ([`buffer_view_refusal`] gives
+/// the index).
+const REFUSALS: [&str; 6] = [
+    "a raw view not on 16 bytes of its host copy",
+    "a raw view without the raw format, or with a stride",
+    "a structured view with a format, or with a stride the host has no buffers for",
+    "a typed view in a format without a size",
+    "a view of no elements",
+    "a view past its buffer's end",
+];
+
+/// [`REFUSED_VIEWS`] by kind ([`REFUSALS`]), since the start.
+static REFUSED_KINDS: [std::sync::atomic::AtomicU64; 6] = [const { std::sync::atomic::AtomicU64::new(0) }; 6];
+
+/// Structured buffer views made as structured views since the start: their
+/// bytes do not start on 16 of the host copy, so they cannot be raw views
+/// of the same bytes ([`raw_window`]). Shaders read them as raw bytes, and
+/// such a read through a structured view gave zeros on NVIDIA; nothing
+/// else counts them.
+static STRUCTURED_LEFT: std::sync::atomic::AtomicU64 = std::sync::atomic::AtomicU64::new(0);
+
+thread_local! {
+    /// The heap slot whose view this thread makes ([`make`]), for the log
+    /// of refused views; `u32::MAX` before the first.
+    static MAKING: std::cell::Cell<u32> = const { std::cell::Cell::new(u32::MAX) };
+}
+
+/// Counts a buffer view the host would refuse, by its kind, and names the
+/// first few of each kind: the heap slot, the title memory the view reads
+/// (`title`: address and bytes) and the fields the host would get. The
+/// lines that were there before name the first refused view only, and the
+/// frame line's count is of all kinds together (run 66: 158 views, one of
+/// them known).
+#[allow(clippy::too_many_arguments)]
+fn note_refused(
+    kind: usize,
+    unordered: bool,
+    title: (u64, u64),
+    format: DXGI_FORMAT,
+    first: u64,
+    count: u32,
+    stride: u32,
+    width: u64,
+) {
+    use std::sync::atomic::Ordering::Relaxed;
+    /// Lines per kind.
+    const NAMED: u64 = 8;
+    REFUSED_VIEWS.fetch_add(1, Relaxed);
+    let (Some(counter), Some(why)) = (REFUSED_KINDS.get(kind), REFUSALS.get(kind)) else {
+        return;
+    };
+    if counter.fetch_add(1, Relaxed) < NAMED {
+        tracing::warn!(
+            slot = MAKING.get(),
+            address = format_args!("{:#x}", title.0),
+            bytes = title.1,
+            format = format.0,
+            first,
+            count,
+            stride,
+            width,
+            unordered,
+            "buffer view left null: {why}"
+        );
+    }
+}
+
+/// With the frame line, when the numbers grew: the buffer views left null
+/// so far by kind, and the structured views left structured.
+pub(crate) fn refused_line() {
+    use std::sync::atomic::Ordering::Relaxed;
+    static LAST: std::sync::atomic::AtomicU64 = std::sync::atomic::AtomicU64::new(0);
+    let left = STRUCTURED_LEFT.load(Relaxed);
+    let total = REFUSED_VIEWS.load(Relaxed) + left;
+    if LAST.swap(total, Relaxed) == total {
+        return;
+    }
+    let kinds: Vec<String> = REFUSALS
+        .iter()
+        .zip(&REFUSED_KINDS)
+        .filter_map(|(why, n)| {
+            let n = n.load(Relaxed);
+            (n > 0).then(|| format!("{n}x {why}"))
+        })
+        .collect();
+    tracing::info!(
+        "buffer views left null so far, by kind: {}; structured views not on 16 bytes of their host copy, made as structured views so far (a raw read through one may give zeros): {left}",
+        if kinds.is_empty() { "none".to_owned() } else { kinds.join("; ") }
+    );
+}
