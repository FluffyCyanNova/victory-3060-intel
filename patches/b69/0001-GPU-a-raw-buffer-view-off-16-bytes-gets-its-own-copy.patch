+}
+
+/// Whether a raw buffer view that is on a dword of its buffer's host copy
+/// but not on 16 bytes of it gets a copy of its own bytes
+/// (`VICTORY_RAW_OWN_COPY=1`; off by default). The host takes a raw view
+/// on 16 bytes only and removes the device for another (upstream #3540);
+/// the console takes any dword. Such a view was refused
+/// ([`buffer_view_refusal`]) and its slot read zeros: "buffer view the host
+/// would refuse left null ... first=2 count=72 ... raw=true" in the runs of
+/// 2026-11-27 and 28, a 288-byte block 8 bytes off 16 in a 4 MiB window.
+fn raw_own_copy() -> bool {
+    static ON: std::sync::OnceLock<bool> = std::sync::OnceLock::new();
+    *ON.get_or_init(|| std::env::var_os("VICTORY_RAW_OWN_COPY").is_some_and(|v| v == "1"))
+}
+
+/// Whether a buffer view with these fields is a raw view the host could
+/// take: the raw flag (`flag`), no stride, the raw format. As
+/// [`buffer_view_refusal`] asks of a raw view, but for where it starts.
+fn raw_view(flag: bool, stride: u32, format: DXGI_FORMAT) -> bool {
+    flag && stride == 0 && format == DXGI_FORMAT_R32_TYPELESS
+}
+
+/// [`own_bytes`] for a raw view: the title memory (start, bytes) of `count`
+/// dwords from dword `first` of the buffer at `base`, which lies `offset`
+/// bytes into its host copy, when the view is on a dword of that copy (off
+/// one it is [`own_bytes_if`]'s) but not on 16 bytes of it. On a copy of
+/// its own bytes it starts at byte 0. `None`: the view is made on its
+/// buffer's copy, as every other.
+fn raw_own_bytes_if(on: bool, offset: u64, base: u64, first: u64, count: u32) -> Option<(u64, u64)> {
+    if !on || count == 0 || !offset.is_multiple_of(4) {
+        return None;
+    }
+    let within = first.checked_mul(4)?;
+    if offset.checked_add(within)?.is_multiple_of(16) {
+        return None;
+    }
+    Some((base.checked_add(within)?, u64::from(count) * 4))
 }
 
