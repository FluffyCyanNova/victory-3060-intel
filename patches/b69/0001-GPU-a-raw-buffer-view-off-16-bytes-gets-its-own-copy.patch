+    /// A refused buffer view names its reason, and the view a raw view off
+    /// 16 bytes becomes on a copy of its own bytes is taken.
+    #[test]
+    fn a_refused_buffer_view_names_its_reason() {
+        let raw = DXGI_FORMAT_R32_TYPELESS;
+        // the view of the runs' log: dword 2 of a 4 MiB copy
+        assert_eq!(buffer_view_refusal(raw, 2, 72, 0, true, 4_194_304), Some(0));
+        assert_eq!(REFUSALS[0], "a raw view not on 16 bytes of its host copy");
+        // the same bytes on their own copy (288 bytes in a buffer of 512)
+        assert_eq!(buffer_view_refusal(raw, 0, 72, 0, true, 512), None);
+        assert_eq!(buffer_view_refusal(DXGI_FORMAT_UNKNOWN, 0, 72, 0, true, 4096), Some(1));
+        assert_eq!(buffer_view_refusal(DXGI_FORMAT_UNKNOWN, 0, 10, 6, false, 4096), Some(2));
+        assert_eq!(buffer_view_refusal(DXGI_FORMAT_UNKNOWN, 0, 10, 0, false, 4096), Some(3));
+        assert_eq!(buffer_view_refusal(raw, 0, 0, 0, true, 4096), Some(4));
+        assert_eq!(buffer_view_refusal(raw, 0, 72, 0, true, 256), Some(5));
+        assert_eq!(REFUSALS.len(), REFUSED_KINDS.len());
+        // the raw views the own-copy rule takes: the flag, no stride, the raw format
+        assert!(raw_view(true, 0, raw));
+        assert!(!raw_view(false, 0, raw));
+        assert!(!raw_view(true, 4, raw));
+        assert!(!raw_view(true, 0, DXGI_FORMAT_R32_FLOAT));
+    }
