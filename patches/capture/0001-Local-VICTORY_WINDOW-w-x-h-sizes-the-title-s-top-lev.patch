From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: VIctory contributor <contributor@users.noreply.invalid>
Date: Wed, 25 Nov 2026 06:22:05 +0800
Subject: [PATCH 1/3] Local: VICTORY_WINDOW=<w>x<h> sizes the title's top-level
 window (diagnostics runs at 720p)

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 crates/victory-hle/src/modules/lifecycle.rs | 12 ++++++++++++
 1 file changed, 12 insertions(+)

diff --git a/crates/victory-hle/src/modules/lifecycle.rs b/crates/victory-hle/src/modules/lifecycle.rs
index f1b577719..79d59c4e2 100644
--- a/crates/victory-hle/src/modules/lifecycle.rs
+++ b/crates/victory-hle/src/modules/lifecycle.rs
@@ -116,6 +116,18 @@ pub extern "system" fn CreateWindowExA(
 /// its proportions, and centred; what it shows is scaled to it (the swap
 /// chain stretches).
 fn fit(parent: HWND, x: i32, y: i32, width: i32, height: i32) -> (i32, i32, i32, i32) {
+    // Local: `VICTORY_WINDOW=<width>x<height>` sizes a top-level title
+    // window outright (the swap chain is stretched into it).
+    if parent.is_null()
+        && width > 0
+        && let Some((w, h)) = std::env::var("VICTORY_WINDOW").ok().and_then(|v| {
+            let (w, h) = v.trim().split_once(['x', 'X'])?;
+            Some((w.parse::<i32>().ok()?, h.parse::<i32>().ok()?))
+        })
+    {
+        tracing::info!(width, height, to = ?(w, h), "title window sized by VICTORY_WINDOW");
+        return (x, y, w, h);
+    }
     let mut area = RECT::default();
     // SAFETY: `area` receives the primary monitor's work area.
     let known =
